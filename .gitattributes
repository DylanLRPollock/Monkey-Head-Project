###############################################################################
# Generated / minified / lock files -- avoid noisy diffs
###############################################################################

# --- Minified front-end bundles --------------------------------------------
*.min.js    -diff linguist-generated=true
*.min.css   -diff linguist-generated=true
*.min.mjs   -diff linguist-generated=true
*.min.json  -diff linguist-generated=true
*.map       -diff linguist-generated=true

# --- Lock files ------------------------------------------------------------
# `-diff` treats these as opaque in review; `linguist-generated=true` keeps
# them out of language statistics. `bun.lockb` is genuinely binary.
package-lock.json    -diff linguist-generated=true
npm-shrinkwrap.json  -diff linguist-generated=true
yarn.lock            -diff linguist-generated=true
pnpm-lock.yaml       -diff linguist-generated=true
bun.lock             -diff linguist-generated=true
bun.lockb            binary linguist-generated=true
Pipfile.lock         -diff linguist-generated=true
poetry.lock          -diff linguist-generated=true
uv.lock              -diff linguist-generated=true
pdm.lock             -diff linguist-generated=true
Cargo.lock           -diff linguist-generated=true
go.sum               -diff linguist-generated=true
composer.lock        -diff linguist-generated=true
Gemfile.lock         -diff linguist-generated=true
mix.lock             -diff linguist-generated=true
flake.lock           -diff linguist-generated=true
*.lock               -diff linguist-generated=true

###############################################################################
# GitHub Linguist hints
###############################################################################

# Documentation trees and top-level prose.
docs/**             linguist-documentation=true
*.md                linguist-documentation=true

# Runtime/memory data is generated, even when committed for fixtures.
memory/**           linguist-generated=true

# Vendored or third-party code -- excluded from language stats.
src/huey/connectors/pyhuey/**  linguist-vendored=true
integrations/command-center/** linguist-vendored=true
vendor/**                      linguist-vendored=true
third_party/**                 linguist-vendored=true
third-party/**                 linguist-vendored=true

###############################################################################
# Export-ignore for release tarballs
###############################################################################

# Exclude CI, tests, docs, and dev-only files from `git archive` exports so
# users installing from a release tarball get the package, not the workshop.
.github/                 export-ignore
tests/                   export-ignore
test/                    export-ignore
docs/                    export-ignore
scripts/dev/             export-ignore
scripts/benchmarks/      export-ignore
.editorconfig            export-ignore
.flake8                  export-ignore
.gitattributes           export-ignore
.gitignore               export-ignore
.gitmodules              export-ignore
.pre-commit-config.yaml  export-ignore
.readthedocs.yaml        export-ignore
.mypy.ini                export-ignore
.pytest.ini              export-ignore
conftest.py              export-ignore