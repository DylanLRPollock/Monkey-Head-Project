# --- CRLF exceptions -------------------------------------------------------
# Windows-only scripts. Batch and PowerShell hosts behave better with CRLF
# and these files are only ever edited on Windows anyway. Stored as LF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
