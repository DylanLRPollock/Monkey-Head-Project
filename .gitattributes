###############################################################################
# Core text handling / line endings
###############################################################################

# Normalize line endings for all text; store LF in the repo.
# This overrides platform defaults so Windows checkouts also see LF.
* text=auto eol=lf

# Explicit text types that must always be LF
*.sh          text eol=lf
*.bash        text eol=lf
*.py          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.md          text eol=lf
*.env         text eol=lf
*.cfg         text eol=lf
*.ini         text eol=lf
*.txt         text eol=lf
*.json        text eol=lf
*.csv         text eol=lf
*.tsv         text eol=lf

# Project / infra files
.gitattributes text eol=lf
.gitignore     text eol=lf
Dockerfile     text eol=lf
docker-compose*.yml text eol=lf

###############################################################################
# Binary assets (no end-of-line normalization, no text diffs)
###############################################################################

# Images
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.bmp  binary
*.tif  binary
*.tiff binary

# Documents/media
*.pdf  binary
*.mp4  binary
*.mov  binary
*.mkv  binary
*.webm binary
*.wav  binary
*.mp3  binary
*.flac binary
*.ogg  binary

# Archives / compressed artifacts
*.zip  binary
*.tar  binary
*.gz   binary
*.bz2  binary
*.xz   binary
*.7z   binary
*.rar  binary
*.iso  binary

# Fonts and other opaque binary formats
*.exe   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.eot   binary

###############################################################################
# Generated / minified / lock files – avoid noisy diffs
###############################################################################

# Minified front-end bundles
*.min.js  -diff
*.min.css -diff

# Lock files (npm, pip, etc.) – treat as opaque blobs in diffs
*.lock    -diff

###############################################################################
# Documentation / metadata / generated runtime data
###############################################################################

# All documentation treated as documentation for GitHub Linguist
docs/** linguist-documentation=true

# Memory and runtime data (if ever committed) are treated as generated
memory/** linguist-generated=true

###############################################################################
# Vendored or third-party code (submodules, mirrors, etc.)
###############################################################################

# PyHuey packaged connector code and umbrella companion submodules are treated as
# vendored code so they do not skew language stats.
src/huey/connectors/pyhuey/** linguist-vendored=true
integrations/command-center/** linguist-vendored=true

###############################################################################
# Export-ignore for release tarballs
###############################################################################

# Exclude CI, tests, docs, and dev-only scripts from `git archive` exports.
.github/      export-ignore
tests/        export-ignore
docs/         export-ignore
scripts/dev/  export-ignore
