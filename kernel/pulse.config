# HueyPulse kernel profile.
#
# Applies to control, sensor, and watchdog focused HueyPulse systems.
# Intended to be merged with kernel/base.config.

# Deterministic scheduling / lower jitter
CONFIG_PREEMPT_RT=y
CONFIG_NO_HZ_FULL=y
CONFIG_HZ_1000=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

# Keep footprint smaller than desktop builds
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_SND_HDA_CODEC_HDMI is not set

# Control buses + industrial/sensor interfaces
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_SPI=y
CONFIG_SPI_SPIDEV=y
CONFIG_GPIO_CDEV=y
CONFIG_PPS=y
CONFIG_PTP_1588_CLOCK=y
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_DEV=y

# Sensor framework
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGER=y
CONFIG_HWMON=y
CONFIG_THERMAL=y

# Serial/USB field connectivity
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y

# Reliability + watchdog coverage
CONFIG_WATCHDOG=y
CONFIG_SOFT_WATCHDOG=y
CONFIG_ITCO_WDT=y
CONFIG_GPIO_WATCHDOG=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y

# Remote maintenance / observability
CONFIG_NETCONSOLE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
