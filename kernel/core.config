# Huey Core kernel profile.
#
# Applies to desktop + AI + graphics oriented Huey Core systems.
# Intended to be merged with kernel/base.config.

CONFIG_PREEMPT=y
CONFIG_HUGETLBFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_ZSWAP=y
CONFIG_ZSMALLOC=y
CONFIG_NUMA=y
CONFIG_SMP=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y

# GPU / display stack
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_I915=y
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_EFI=y

# Compute / acceleration
CONFIG_DRM_ACCEL=y
CONFIG_HSA_AMD=y
CONFIG_KFD_AMD=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
CONFIG_INTEL_IOMMU=y
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y

# Audio / desktop IO
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_USB_AUDIO=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HIDRAW=y

# AI/developer friendly virtualization stack
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y

# Filesystems commonly used by desktop/dev workflows
CONFIG_FUSE_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
