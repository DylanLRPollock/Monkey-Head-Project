# ---------------------------------------------------------------------------
# Monkey-Head-Project
# Component: HueyOS / Flake8 Configuration
# Author: Dylan L.R. Pollock
# Documentation: https://www.dlrp.ca
#
# Philosophy: Breathing new life into old tech.
# ---------------------------------------------------------------------------
#
# flake8 is the project's structural linter: unused imports, undefined names,
# cyclomatic complexity, and bugbear-style hazards. Formatting is delegated to
# Black, so this file deliberately stays out of the stylistic debate and only
# tunes what flake8 uniquely contributes.
#
# Keep `max-line-length` in sync with Black (see .pre-commit-config.yaml) and
# the `[*]` section of .editorconfig.

[flake8]
# --- Line length -----------------------------------------------------------
# Black's target width. B950 (below) softens the hard cutoff.
max-line-length = 88

# --- Ignores ---------------------------------------------------------------
# Codes silenced because another tool owns the concern:
#   E203 -> whitespace before ':' is Black's slice-formatting choice.
#   E402 -> module-level imports not at top; required in shim modules
#           (run.py, CLI entry points) that mutate sys.path first.
#   E501 -> line length is delegated to B950 below and to Black.
#   W291 -> trailing whitespace is stripped by the pre-commit hook.
#   W293 -> blank-line whitespace, same hook.
#   W503 -> line break before binary operator (legacy pycodestyle).
#   W504 -> line break after binary operator (Black's preferred wrapping).
# pycodestyle 2.5+ disables W503 and W504 by default; listing both keeps the
# intent explicit if anyone runs an older version.
extend-ignore =
    E203,
    E402,
    E501,
    W291,
    W293,
    W503,
    W504

# --- Selection -------------------------------------------------------------
# Explicit plugin contract. Because `select` is used (not `extend-select`),
# a newly installed plugin will not silently start failing CI -- it has to be
# added here first. That is deliberate.
#
#   C4   -> flake8-comprehensions (unnecessary comprehension/constructor nits)
#   C90  -> mccabe cyclomatic complexity
#   E, W -> pycodestyle (style; mostly delegated to Black)
#   F    -> pyflakes (undefined names, unused imports, etc.)
#   B    -> flake8-bugbear (design hazards)
#   B950 -> bugbear's Black-compatible soft line-length check
select =
    C4,
    C90,
    E,
    F,
    W,
    B,
    B950

# Cyclomatic complexity ceiling. 10 is mccabe's default; bump to 15 if
# connector/parser code legitimately exceeds it.
max-complexity = 10

# --- Exclusions ------------------------------------------------------------
# Paths are matched as POSIX-style globs. flake8 normalises path separators
# internally, so do NOT duplicate entries with Windows-style backslashes --
# they would never match and would just be noise in the config.
exclude =
    .git,
    .hg,
    .svn,
    .tox,
    .nox,
    .eggs,
    __pycache__,
    *.egg-info,
    build,
    dist,
    .venv,
    venv,
    env,
    .mypy_cache,
    .ruff_cache,
    .pytest_cache,
    .hypothesis,
    .idea,
    .vscode,
    archives,
    # Vendored / legacy trees kept behind compatibility shims.
    src/huey/connectors/pyhuey,
    src/huey/memory/PY

# --- Per-file relaxations --------------------------------------------------
# Patterns here use POSIX slashes. Add entries as narrowly as possible --
# broad globs hide real findings.
per-file-ignores =
    # Package __init__ files exist to re-export; F401 is the point.
    src/huey/__init__.py: F401
    # Root shim manipulates sys.path before importing huey.run.
    run.py: E402
    # CLI entry-point modules do the same for discovery.
    src/huey/cli/*.py: E402