# HueyOS: .gitignore

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.pyo
*.so
__pypackages__/

# Keep the canonical repository Python pin in version control.

# Virtual environments
.venv/
.venv*/
.venv313-ci/
venv/
env/
ENV/

# Packaging metadata
build/
dist/
*.egg-info/
pip-wheel-metadata/
src/hueyos.egg-info/

# ---------------------------------------------------------------------------
# Dev / tool caches
# ---------------------------------------------------------------------------

.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.huggingface/
.tox/
.nox/
.hypothesis/
.pyre/

# Coverage reports
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------------------------------------------------------------------------
# Documentation build output
# ---------------------------------------------------------------------------

docs/_build/

# ---------------------------------------------------------------------------
# Node / frontend / integration build artifacts
# ---------------------------------------------------------------------------

node_modules/
dist/

integrations/*/node_modules/
integrations/*/dist/
integrations/*/.tmp/
integrations/*/.vite-temp/
integrations/*/.cache/

# Keep package manifests trackable
!integrations/*/package.json
!integrations/*/package-lock.json
!integrations/*/pnpm-lock.yaml
!integrations/*/yarn.lock

# ---------------------------------------------------------------------------
# Logs and runtime artifacts
# ---------------------------------------------------------------------------

*.log
*.sqlite
*.sqlite3

logs/
!logs/.gitkeep

src/huey/memory/LOG/*
!src/huey/memory/LOG/.gitkeep

src/huey/memory/LOGS/*
!src/huey/memory/LOGS/.gitkeep

# ---------------------------------------------------------------------------
# Project data / local memory outputs
# ---------------------------------------------------------------------------

raw/

memory/*
!memory/.gitkeep
!memory/LOGS/
!memory/LOGS/.gitkeep
!memory/RAW/
!memory/RAW/.gitkeep

# ---------------------------------------------------------------------------
# Local env/config
# ---------------------------------------------------------------------------

.env
.env.*
*.env
*.env.*
huey.env

!.env.example
!*.env.example
!*.env.template
!*.env.sample
!huey.env.example

# Local/generated secret-bearing files
config/pygpt_net/config.json

# ---------------------------------------------------------------------------
# Secrets and generated key material
# ---------------------------------------------------------------------------

infra/secrets/*
!infra/secrets/README.md
!infra/secrets/*-example
!infra/secrets/*.pub

secrets/
local_secrets/
**/secrets.local/

*.apikey
*.api_key
apikey.txt
api_key.txt

*.pem
*.key
*.p12
*.jks
*.keystore
id_rsa
id_ed25519

# ---------------------------------------------------------------------------
# Security scan reports
# ---------------------------------------------------------------------------

pip-audit-report*
pip-audit*.json
safety-report*
bandit-report*
bandit-results*.json
bandit-results*.zip

# ---------------------------------------------------------------------------
# Local archive / inspection bundles
# ---------------------------------------------------------------------------

/folders.zip
*-inspection.zip
*-local.zip
*-tmp.zip

# Do not globally ignore all ZIP files; release archives may be intentional.
# Add specific local ZIP patterns above instead.

# ---------------------------------------------------------------------------
# IDE / editor / OS noise
# ---------------------------------------------------------------------------

.vscode/
.idea/
.spyproject/
.ropeproject/

*~
*.swp
*.swo

.DS_Store
Thumbs.db
desktop.ini
