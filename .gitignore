# Belt-and-braces: even if a broader `integrations/*` rule is added later,
# the manifests must stay trackable.
!integrations/*/package.json
!integrations/*/package-lock.json
!integrations/*/pnpm-lock.yaml
!integrations/*/yarn.lock
!integrations/*/tsconfig.json
!integrations/*/vite.config.*
!integrations/*/README.md

