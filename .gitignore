# HueyOS: .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
__pypackages__/
.env
.env.*
!.env.example
.venv/
venv/
env/
.python-version

# Packaging metadata
pip-wheel-metadata/

# Dev/Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.huggingface/
.tox/
.nox/
.hypothesis/

# Coverage reports
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE
.vscode/
.idea/
.spyproject/
.ropeproject/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build/Dist
build/
dist/
*.egg-info/

# Logs & runtime artifacts
*.log
*.sqlite
*.sqlite3
src/huey/memory/LOGS/*
!src/huey/memory/LOGS/.gitkeep

# Secrets and generated key material
infra/secrets/*
!infra/secrets/README.md
!infra/secrets/*-example
!infra/secrets/*.pub
*.pem
*.key
id_rsa
id_ed25519

# Editor backups/swaps
*~
*.swp
*.swo

# Project data
raw/
memory/*
!memory/.gitkeep
!memory/LOGS/
!memory/LOGS/.gitkeep
!memory/RAW/
!memory/RAW/.gitkeep

# Local env/config (real env; example stays tracked)
huey.env
