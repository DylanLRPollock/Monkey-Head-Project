# Huey Core kernel profile.
#
# Applies to AMD desktop + AI/developer-oriented Huey Core systems.
# Intended to be merged with src/huey/core/base.config.

CONFIG_PREEMPT=y
CONFIG_NUMA=y
CONFIG_SMP=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y

# Reusable profile fragments.
# include fragments/storage.config
# include fragments/graphics.config
# include fragments/virtualization.config

# Compute / acceleration (AMD AI/ML path)
CONFIG_DRM_ACCEL=y
CONFIG_HSA_AMD=y
CONFIG_KFD_AMD=y

# Audio / desktop IO
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_USB_AUDIO=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HIDRAW=y
