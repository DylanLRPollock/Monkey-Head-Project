# HueyPulse kernel profile.
#
# Applies to control, sensor, and watchdog focused HueyPulse systems.
# Intended to be merged with src/huey/core/base.config.

# Deterministic scheduling / lower jitter
CONFIG_PREEMPT_RT=y
CONFIG_NO_HZ_FULL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

# Keep footprint and boot path smaller than desktop builds
# CONFIG_DRM is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_SND_HDA_INTEL is not set
# CONFIG_SND_HDA_CODEC_HDMI is not set
# CONFIG_BT_HCIBTUSB is not set

# Reusable profile fragments.
# include fragments/serial-gpio.config
# include fragments/sensors.config

# Reliability + watchdog coverage
# WATCHDOG is already enabled in base.config; keep device coverage here.
CONFIG_SOFT_WATCHDOG=y
CONFIG_ITCO_WDT=y
CONFIG_GPIO_WATCHDOG=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y

# Remote maintenance / observability
CONFIG_NETCONSOLE=y
# MAGIC_SYSRQ is already enabled in base.config.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
