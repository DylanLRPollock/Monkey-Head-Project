# HueyOS canonical base kernel configuration.
#
# This file is the tracked baseline used for all HueyOS kernel builds.
# Product-specific profiles (for example core.config and pulse.config)
# are layered on top of this baseline via merge_config.sh or equivalent.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_NVME=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES_X86_64=y
CONFIG_CRYPTO_SHA256=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_FB=y
CONFIG_DRM=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_RTC_CLASS=y
CONFIG_WATCHDOG=y
CONFIG_HZ_1000=y
CONFIG_KALLSYMS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_AHCI=y
CONFIG_DRM_AMDGPU=y
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_BT_HCIBTUSB=m
CONFIG_MD_RAID456=y
CONFIG_DM_RAID=y
CONFIG_FIRMWARE_IN_KERNEL=y
