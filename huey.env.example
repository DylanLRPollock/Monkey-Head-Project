# HueyOS: example 'env'

# ---------------------------------------------------------------------------
# Core HueyOS network settings
# ---------------------------------------------------------------------------
HUEY_HOST=127.0.0.1
HUEY_PORT=1995

# Optional bearer token for the FastAPI control surface.
# When set, every endpoint except /healthz requires:
#   Authorization: Bearer <token>
HUEY_API_TOKEN=

# Environment: development | staging | production
HUEY_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
HUEY_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Paths (on-robot filesystem layout)
# ---------------------------------------------------------------------------
# Base install root for HueyOS
HUEY_ROOT=/opt/hueyos

# Persistent memory root
HUEY_MEMORY_ROOT=/opt/hueyos/memory

# Structured subdirectories for memory
PDF_DIR=/opt/hueyos/memory/PDF
LOG_DIR=/opt/hueyos/memory/LOGS

# ---------------------------------------------------------------------------
# Local model / runtime backends
# ---------------------------------------------------------------------------
# Ollama (local LLM backend). Leave as-is if running on the same host.
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model name for HueyOS to request from Ollama
HUEY_DEFAULT_MODEL=mistral

# ---------------------------------------------------------------------------
# External APIs (optional; HueyOS remains offline-first)
# ---------------------------------------------------------------------------
# Leave these empty for fully offline operation.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Locale / misc
# ---------------------------------------------------------------------------
# System timezone for scheduling / logs
HUEY_TIMEZONE=America/Toronto
