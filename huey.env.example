# ---------------------------------------------------------------------------
# Monkey-Head-Project
# Component: HueyOS / Example Environment
# Author: Dylan L.R. Pollock
# Documentation: https://www.dlrp.ca
#
# Philosophy: Breathing new life into old tech.
# ---------------------------------------------------------------------------
#
# Copy this file to `huey.env` for local use:
#
#     cp huey.env.example huey.env
#
# `huey.env` is gitignored. This example file is not -- it is the canonical
# list of variables HueyOS reads at startup, so keep it in sync whenever a
# new setting is added to the loader.
#
# Rules for this file:
#   * Only use placeholder values. Never put a real secret here.
#   * Every variable must have a working default for a fresh local install,
#     so `cp huey.env.example huey.env` is a valid starting point.
#   * Variables that are optional but commonly set live in their own section
#     below; don't bury them in "misc".
#   * Boolean values are `true` / `false` (lowercase), not `1` / `0` / `yes`.
#   * Paths are POSIX-style even on Windows, since HueyOS deploys to Linux.

# ---------------------------------------------------------------------------
# Core network settings
# ---------------------------------------------------------------------------
# Interface the control surface binds to. `127.0.0.1` is correct for a
# single-host install; use `0.0.0.0` only if you intend to expose the API
# and have set a strong HUEY_API_TOKEN.
HUEY_HOST=127.0.0.1

# Port for the FastAPI control surface.
HUEY_PORT=1995

# Bearer token for the control surface.
#
# In development/local (HUEY_ENV=development or local) this may be left empty.
# In staging/production (or any other HUEY_ENV value), startup fails unless
# HUEY_API_TOKEN is set to a real, non-placeholder secret.
#
# Every endpoint except /healthz requires:
#     Authorization: Bearer <token>
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
HUEY_API_TOKEN=

# Runtime environment: development | local | staging | production
# Controls: token enforcement, debug tracebacks, verbose request logging.
HUEY_ENV=development

# Log verbosity: DEBUG | INFO | WARNING | ERROR
HUEY_LOG_LEVEL=INFO

# Optional: bind address for the internal task/worker socket, if enabled.
# Leave unset for the default (HUEY_HOST on an ephemeral port).
# HUEY_WORKER_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Filesystem layout
# ---------------------------------------------------------------------------
# Base install root for HueyOS.
HUEY_ROOT=/opt/hueyos

# Persistent memory root. Must be writable by the HueyOS service account.
HUEY_MEMORY_ROOT=/opt/hueyos/memory

# Structured subdirectories. These are conventional locations; individual
# connectors may reference them, but the loader will create them on demand.
PDF_DIR=/opt/hueyos/memory/PDF
LOG_DIR=/opt/hueyos/memory/LOGS
RAW_DIR=/opt/hueyos/memory/RAW

# Optional: directory for temporary working files. Defaults to the system
# temp dir if unset.
# HUEY_TMP_DIR=/var/tmp/hueyos

# ---------------------------------------------------------------------------
# Local model / runtime backends
# ---------------------------------------------------------------------------
# Ollama (local LLM backend). Leave as-is if running on the same host.
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model HueyOS requests from Ollama. Pick one you have pulled:
#     ollama pull mistral
HUEY_DEFAULT_MODEL=mistral

# Optional: model used for embedding / retrieval tasks, if different from
# the default. Leave unset to reuse HUEY_DEFAULT_MODEL.
# HUEY_EMBED_MODEL=nomic-embed-text

# Optional: request timeout (seconds) for local model calls.
# HUEY_MODEL_TIMEOUT=120

# ---------------------------------------------------------------------------
# External APIs (optional; HueyOS remains offline-first)
# ---------------------------------------------------------------------------
# Leave these empty for fully offline operation. If all are empty, HueyOS
# will not attempt any outbound API calls and will fall back to local
# backends exclusively.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the base URL for an OpenAI-compatible endpoint.
# Useful for pointing at a local gateway or a self-hosted proxy.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: default model per provider when the key is set. Leaving these
# blank lets the connector choose its own default.
# OPENAI_DEFAULT_MODEL=
# GOOGLE_DEFAULT_MODEL=
# ANTHROPIC_DEFAULT_MODEL=
# OPENROUTER_DEFAULT_MODEL=

# ---------------------------------------------------------------------------
# Connectors
# ---------------------------------------------------------------------------
# Per-connector enable flags. Disabled connectors are not imported at
# startup, which keeps cold-start time down on constrained hardware.
# Enable only what you actually use.
HUEY_ENABLE_OLLAMA=true
HUEY_ENABLE_PDF=true

# Optional connectors -- off by default because they need external keys,
# network access, or additional system packages.
HUEY_ENABLE_OPENAI=false
HUEY_ENABLE_GOOGLE=false
HUEY_ENABLE_ANTHROPIC=false
HUEY_ENABLE_OPENROUTER=false

# Legacy PyHuey connector. Off unless you are explicitly maintaining it.
HUEY_ENABLE_PYHUEY=false

# ---------------------------------------------------------------------------
# Security and request limits
# ---------------------------------------------------------------------------
# Optional: comma-separated allowlist of origins for the web UI. Leave
# unset to disable CORS entirely (the safe default for a local install).
# HUEY_CORS_ORIGINS=http://localhost:1995

# Optional: maximum request body size in megabytes. Defaults to 8.
# HUEY_MAX_UPLOAD_MB=8

# Optional: seconds before an idle API request is dropped. Defaults to 60.
# HUEY_REQUEST_TIMEOUT=60

# Optional: set to `true` to run behind a TLS-terminating proxy that sets
# X-Forwarded-* headers. Leave `false` unless you actually have one.
HUEY_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Locale / scheduling
# ---------------------------------------------------------------------------
# IANA timezone name. Used for cron-style scheduling and log timestamps.
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
HUEY_TIMEZONE=America/Toronto

# Optional: locale for date formatting in the UI. Defaults to en_CA.
# HUEY_LOCALE=en_CA

# ---------------------------------------------------------------------------
# Telemetry / diagnostics
# ---------------------------------------------------------------------------
# HueyOS never phones home. These settings control *local* diagnostics only.
# Optional: write structured JSON logs alongside human-readable ones.
HUEY_JSON_LOGS=false

# Optional: enable Python's faulthandler for crash-time stack dumps.
# Useful on embedded hardware; leave off for normal operation.
HUEY_FAULTHANDLER=false

# Optional: directory for crash dumps and diagnostic bundles.
# HUEY_DIAG_DIR=/opt/hueyos/diagnostics